# ML Service Environment Variables

# Server Configuration
ENVIRONMENT=development
PORT=8000

# Geospatial Data Processing
RASTERIO_ENV=production
GDAL_DATA=/usr/share/gdal

# Model Configuration
MODEL_WEIGHTS_PATH=./models/unet_sentinel2_v1.pth
MODEL_DEVICE=cpu

# Cache and Data Storage
CACHE_DIR=./data/cache
TEMP_DIR=./data/temp
MAX_CACHE_SIZE_MB=1000

# Copernicus API (Same as backend)
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Processing Limits
MAX_AREA_KM2=1000
MAX_PROCESSING_TIME_SECONDS=300
