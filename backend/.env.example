# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecosense_ai

# Copernicus Data Space API (https://dataspace.copernicus.eu/)
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# AI Agent / LLM Provider (Optional - will use fallback if not provided)
# Option 1: OpenAI
OPENAI_API_KEY=sk-your_openai_key_here
# Option 2: Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Provider Selection (openai | anthropic | fallback)
LLM_PROVIDER=fallback

# Python ML Service
# For local development: use http://localhost:8000
# For Render deployment: set ML_SERVICE_HOST to the ML service's RENDER_EXTERNAL_HOSTNAME (e.g., ecosense-ml-service.onrender.com)
# The backend will construct https:// + ML_SERVICE_HOST automatically
ML_SERVICE_HOST=127.0.0.1:8000

# Security
JWT_SECRET=change_this_to_random_secret_key_in_production
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100
